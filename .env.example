# Copie para .env (local) e configure as MESMAS variáveis na Vercel
# (Project → Settings → Environment Variables).

# Chave da Anthropic — fica SÓ no servidor, nunca no navegador.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (opcional) modelo da Claude
ANTHROPIC_MODEL=claude-sonnet-4-6

# Login sem banco de dados. Vários usuários separados por vírgula: "user:senha,user2:senha2"
AUTH_USERS=admin:troque-esta-senha

# Segredo para assinar o token de sessão. Gere um aleatório longo, ex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=coloque-um-segredo-aleatorio-bem-longo-aqui

# (opcional) libera origem externa pro /api. Em deploy único na Vercel, deixe em branco.
# CORS_ORIGIN=https://seu-site.vercel.app

# (opcional, só dev) porta do servidor de API local
API_PORT=3000
